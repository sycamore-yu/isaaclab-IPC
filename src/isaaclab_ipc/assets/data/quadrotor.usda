(
    defaultPrim = "Quadrotor"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "Quadrotor" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    kind = "component"
)
{
    # Floating articulation: no joint connects base to the world.
    # The fixed rotor links remain explicit bodies for thruster bindings.
    def Xform "base" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        bool physics:rigidBodyEnabled = true
        bool physics:kinematicEnabled = false
        float physics:mass = 0.746
        point3f physics:centerOfMass = (0, 0, 0)
        float3 physics:diagonalInertia = (0.011916, 0.011916, 0.011836)
        quatf physics:principalAxes = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Sphere "base_collision" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double radius = 0.25
            bool physics:collisionEnabled = true
            color3f[] primvars:displayColor = [(0.35, 0.40, 0.45)]
            float[] primvars:displayOpacity = [0.15]
        }

        # Visual-only arms: no PhysicsCollisionAPI or mass properties.
        def Capsule "arm_0_visual"
        {
            uniform token axis = "Z"
            double radius = 0.009
            double height = 0.2
            double3 xformOp:translate = (0.07071067811865475, 0.07071067811865475, 0)
            quatd xformOp:orient = (0.7071067811865476, -0.5, 0.5, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
            color3f[] primvars:displayColor = [(0.18, 0.20, 0.22)]
        }
