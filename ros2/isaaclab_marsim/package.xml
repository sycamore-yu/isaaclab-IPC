<?xml version="1.0"?>
<package format="3">
  <name>isaaclab_marsim</name>
  <version>0.1.0</version>
  <description>MARSIM evaluation with original ideal execution and native Flightmare dynamics.</description>
  <maintainer email="dev@example.com">Isaac Lab IPC Contributors</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>pcl_conversions</depend>
  <depend>mars_quadrotor_msgs</depend>
  <depend>marsim_render</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>
  <depend>opencv</depend>
  <depend>libglfw3-dev</depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs_py</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>perfect_drone_sim</exec_depend>
  <exec_depend>super_planner</exec_depend>
  <exec_depend>mission_planner</exec_depend>
  <export><build_type>ament_cmake</build_type></export>
</package>
